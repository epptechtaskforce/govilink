{
  "name": "GoviLink",
  "short_name": "GoviLink",
  "description": "Know your farmers. Reach the right ones.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c2217",
